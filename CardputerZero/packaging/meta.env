PKG_NAME=janos-cardputer
PKG_VERSION=0.1.0
PKG_REVISION=${PKG_REVISION:-m5stack1}
PKG_DESC="Native projectZero/JanOS UART controller for M5Stack Cardputer Zero"
PKG_DEPENDS="python3, python3-pil, python3-evdev, python3-serial, fonts-dejavu-core"
PKG_MAINTAINER="LAB5 / D3h420 <noreply@github.com>"
PKG_HOMEPAGE="https://github.com/D3h420/JanOS-app"
APP_NAME="JanOS Controller"
APP_EXEC=/usr/share/APPLaunch/bin/janos-cardputer
APP_TERMINAL=false
APP_ICON=share/images/janos-cardputer.xpm
APP_SYSPLAUSE=false

